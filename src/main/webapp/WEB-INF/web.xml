<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <filter>
        <filter-name>wicket.scoreboard</filter-name>
        <filter-class>org.apache.wicket.protocol.http.WicketFilter</filter-class>
        <init-param>
            <param-name>applicationClassName</param-name>
            <param-value>br.com.scoreboard.web.WicketApplication</param-value>
        </init-param>
        <init-param>
            <param-name>filterMappingUrlPattern</param-name>
            <param-value>/*</param-value>
        </init-param>
        <init-param>
            <param-name>ignorePaths</param-name>
            <param-value>/api/*,/openapi/*,/jogos/*,/api,/openapi,/jogos,/openapi-ui/*,/openapi-ui,/swagger/*,/swagger,/swagger-ui/*,/swagger-ui,/swagger-ui.html</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>wicket.scoreboard</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>